# ---- Backend (.env at repo root) ----

# Groq API — powers all reasoning agents (Qwen 3). Get a free key at console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=qwen/qwen3-32b

# Typhoon API — Thai-language interpreter. Free tier at opentyphoon.ai
# Optional: if missing/invalid, the Thai interpreter falls back to Groq automatically.
TYPHOON_API_KEY=your_typhoon_key_here
TYPHOON_MODEL=typhoon-v2.1-12b-instruct
TYPHOON_API_BASE=https://api.opentyphoon.ai/v1

# Persistence
DATABASE_URL=sqlite:///./wealth_advisor.db
CHECKPOINT_DB_PATH=./langgraph_checkpoints.sqlite

# CORS: comma-separated allowed frontend origins. Use "*" for local dev,
# set to your deployed frontend URL in production (no trailing slash).
CORS_ORIGINS=*

# Fall back to deterministic mock data if a live LLM call fails.
# Keep false in production; set true only for local testing without the LLM.
USE_MOCK_FALLBACK=false

VERBOSE=true

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
